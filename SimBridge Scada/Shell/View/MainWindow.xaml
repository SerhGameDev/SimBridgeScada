<Window x:Class="SimBridge_Scada.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:SimBridge_Scada.Views" xmlns:controls="clr-namespace:SimBridge_Scada.Controls" xmlns:menus="clr-namespace:SimBridge_Scada.Shared.Menus"
 Title="SimBridge SCADA — Редактор мнемосхем" Width="1440" Height="900" MinWidth="1080" MinHeight="680" Background="#262626" Foreground="#DFE1E5" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="#202124" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,0"><DockPanel>
   <Border DockPanel.Dock="Left" Background="#6B57FF" CornerRadius="5" Width="26" Height="26" Margin="0,0,10,0"><TextBlock Text="S" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
   <TextBlock DockPanel.Dock="Left" Text="SimBridge" FontWeight="SemiBold" Margin="0,0,24,0"/><Button DockPanel.Dock="Left" Content="Файл" DataContext="{Binding FileMenu}" menus:LeftClickMenu.IsEnabled="True" menus:LeftClickMenu.MouseButton="Left" Padding="10,4" Margin="0,8,20,8"/>
   <TextBlock Text="SCADA / Редактор мнемосхем" Foreground="#9DA0A8"/>
  </DockPanel></Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="55"/>
    <ColumnDefinition Width="{Binding LeftSidebar.Width, Mode=TwoWay, Converter={StaticResource SidebarWidthConverter}}"/>
    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="{Binding RightSidebar.Width, Mode=TwoWay, Converter={StaticResource SidebarWidthConverter}}"/>
                <ColumnDefinition Width="55"/>
   </Grid.ColumnDefinitions>
   <ContentControl Content="{Binding LeftSidebar}"  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <views:FixedPanelView Grid.Column="1" DataContext="{Binding LeftSidebar.ActivePanel}" Visibility="{Binding DataContext.LeftSidebar.IsPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
   <controls:SidebarGridSplitter Sidebar="{Binding LeftSidebar}" PanelColumnIndex="1" Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="#202124" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="{Binding LeftSidebar.IsPanelOpen, Converter={StaticResource BoolVisibility}}"/>
   <ContentControl Grid.Column="3" Content="{Binding Workspaces}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <controls:SidebarGridSplitter Sidebar="{Binding RightSidebar}" PanelColumnIndex="5" Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="#202124" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="{Binding RightSidebar.IsPanelOpen, Converter={StaticResource BoolVisibility}}"/>
   <views:FixedPanelView Grid.Column="5" DataContext="{Binding RightSidebar.ActivePanel}" Visibility="{Binding DataContext.RightSidebar.IsPanelOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}"/>
   <ContentControl Grid.Column="6" Content="{Binding RightSidebar}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
  <views:EditorStatusView Grid.Row="2" DataContext="{Binding Workspaces.ActiveViewModel}"/>
 </Grid>
</Window>




