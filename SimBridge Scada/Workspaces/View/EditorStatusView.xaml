<UserControl x:Class="SimBridge_Scada.Views.EditorStatusView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="#202124" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,0"><DockPanel>
  <TextBlock DockPanel.Dock="Left" Text="{Binding Elements.Count, StringFormat='Элементов: {0}'}" FontSize="11" Margin="0,0,20,0"/>
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding ZoomText}" Command="{Binding ResetZoomCommand}" Padding="8,2" Width="64" VerticalAlignment="Center"/>
            </StackPanel>
  <TextBlock Text="СКМ — перемещение  ·  Колесо — масштаб  ·  Delete — удалить" Foreground="#81858C" FontSize="11"/>
 </DockPanel></Border>
</UserControl>


