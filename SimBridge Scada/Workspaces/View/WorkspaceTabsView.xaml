<UserControl x:Class="SimBridge_Scada.Views.WorkspaceTabsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:files="clr-namespace:SimBridge_Scada.Shared.FileDrop" xmlns:menus="clr-namespace:SimBridge_Scada.Shared.Menus" files:FileDrop.IsEnabled="True">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition/></Grid.RowDefinitions>
  <Border Background="#242629" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="＋" Command="{Binding CreateWorkspaceCommand}" ToolTip="Новая мнемосхема" Padding="10,0" Margin="4"/>
    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabsWheel">
     <ItemsControl ItemsSource="{Binding OpenWorkspaces}" AllowDrop="True" Drop="TabsDrop" DragOver="TabsDragOver">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border menus:LeftClickMenu.IsEnabled="True" x:Name="TabHeader" AllowDrop="True" BorderBrush="#43454A" BorderThickness="0,0,1,0" MinWidth="150" MaxWidth="250" Height="38" PreviewMouseLeftButtonDown="TabDown" PreviewMouseMove="TabMove" Background="Transparent">
        <Grid>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="2"/></Grid.RowDefinitions>
         <DockPanel Margin="12,0,6,0">
          <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseCommand}" Padding="5,0" Margin="8,7,0,7" ToolTip="Закрыть вкладку"/>
          <TextBlock DockPanel.Dock="Left" Text="▱" Foreground="#73C991" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/>
         </DockPanel>
         <Border x:Name="ActiveLine" Grid.Row="1" Background="Transparent"/>
        </Grid>
       </Border>
       <DataTemplate.Triggers>
        <Trigger SourceName="TabHeader" Property="IsMouseOver" Value="True"><Setter TargetName="TabHeader" Property="Background" Value="#303236"/></Trigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter TargetName="TabHeader" Property="Background" Value="#34302A"/><Setter TargetName="ActiveLine" Property="Background" Value="#D6AA65"/></DataTrigger>
       </DataTemplate.Triggers>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <TextBlock Text="Откройте мнемосхему в панели «Рабочие области» или создайте новую кнопкой +" Foreground="#81858C" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasOpenWorkspaces}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <ContentControl Content="{Binding ActiveViewModel}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Grid>
</UserControl>




