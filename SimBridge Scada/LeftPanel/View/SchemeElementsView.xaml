<UserControl x:Class="SimBridge_Scada.Views.SchemeElementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:menus="clr-namespace:SimBridge_Scada.Shared.Menus">
 <DockPanel DataContext="{Binding Workspace}" Margin="8">
  <Button DockPanel.Dock="Top" Content="＋  Пустой объект" Command="{Binding CreateEmptyCommand}" Margin="0,0,0,10"/>
  <TreeView x:Name="Hierarchy" ItemsSource="{Binding RootElements}" Background="Transparent" BorderThickness="0" Foreground="#DFE1E5" SelectedItemChanged="SelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" DragOver="DragOverNode" Drop="DropNode" ToolTip="Перетащите на объект — сделать дочерним; на край строки — изменить порядок; в пустое место — сделать корневым">
   <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem">
    <Setter Property="IsExpanded" Value="{Binding IsHierarchyExpanded,Mode=TwoWay}"/><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=OneWay}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
     <StackPanel><Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ToggleButton x:Name="Fold" Width="16" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><TextBlock x:Name="Arrow" Text="▸" Foreground="#9DA0A8" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Text" Value="▾"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter Grid.Column="1" ContentSource="Header" HorizontalAlignment="Stretch"/>
     </Grid><ItemsPresenter x:Name="Children" Margin="16,0,0,0"/></StackPanel>
     <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="HasItems" Value="False"><Setter TargetName="Fold" Property="Visibility" Value="Hidden"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></TreeView.ItemContainerStyle>
   <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}">
    <Border menus:LeftClickMenu.IsEnabled="True" Padding="6,4" CornerRadius="3">
     <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#2E4361"/></DataTrigger><DataTrigger Binding="{Binding EffectiveIsEnabled}" Value="False"><Setter Property="Opacity" Value="0.45"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><TextBlock DockPanel.Dock="Left" Text="◇" Foreground="#9DA0A8" Margin="0,0,6,0"/><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Border>
   </HierarchicalDataTemplate></TreeView.ItemTemplate>
  </TreeView>
 </DockPanel>
</UserControl>

