<UserControl x:Class="SimBridge_Scada.Views.WorkspaceExplorerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:menus="clr-namespace:SimBridge_Scada.Shared.Menus">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top">
   <Button Content="Открыть файл…" Command="{Binding OpenFileCommand}" Margin="0,0,0,8"/>
   <Button Content="Сохранить все в один файл…" Command="{Binding SaveAllCommand}" Margin="0,0,0,8"/>
  </StackPanel>
  <Button DockPanel.Dock="Top" Content="＋  Новая мнемосхема" Command="{Binding Manager.CreateWorkspaceCommand}" Margin="0,0,0,14"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Manager.AllWorkspaces}"><ItemsControl.ItemTemplate><DataTemplate>
   <DockPanel Margin="0,0,0,6">
    <Button Command="{Binding OpenCommand}" menus:LeftClickMenu.IsEnabled="True" HorizontalContentAlignment="Stretch" Padding="10,10" ToolTip="{Binding FilePath}">
     <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="#2E4361"/><Setter Property="BorderBrush" Value="#6B9BFA"/></DataTrigger></Style.Triggers></Style></Button.Style>
     <DockPanel><TextBlock DockPanel.Dock="Right" Text="●" Foreground="#73C991" Margin="8,0,0,0" Visibility="{Binding IsOpen, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Button>
   </DockPanel>
  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</UserControl>


