<UserControl x:Class="SimBridge_Scada.Views.PropertiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:menus="clr-namespace:SimBridge_Scada.Shared.Menus">
 <DockPanel DataContext="{Binding Workspace}">
  <StackPanel DockPanel.Dock="Bottom" Margin="12">
   <CheckBox Content="Привязка к сетке (20 px)" IsChecked="{Binding SnapToGrid}"/>
   <Button Content="Удалить объект" Command="{Binding RemoveSelectedCommand}" Margin="0,8,0,0"/>
  </StackPanel>
  <Grid>
   <TextBlock Text="Выберите объект на схеме или в списке элементов." Foreground="#81858C" TextWrapping="Wrap" Margin="14" VerticalAlignment="Top">
    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedElement}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
   </TextBlock>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel DataContext="{Binding SelectedElement}">
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
     <TextBlock Text="{Binding TypeName}" Foreground="#9DA0A8" FontSize="11" Margin="12,12"/>
     <ItemsControl ItemsSource="{Binding Components}"><ItemsControl.ItemTemplate><DataTemplate>
      <Expander Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Style="{StaticResource InspectorComponent}">
       <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch"/>
      </Expander>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Button Content="＋  Добавить компонент" Margin="12,16" DataContext="{Binding DataContext.AddComponentMenu, RelativeSource={RelativeSource AncestorType=UserControl}}" menus:LeftClickMenu.IsEnabled="True" menus:LeftClickMenu.MouseButton="Left"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>

