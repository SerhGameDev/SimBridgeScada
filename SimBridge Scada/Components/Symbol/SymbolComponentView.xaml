<UserControl x:Class="SimBridge_Scada.Views.SymbolComponentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ComboBox SelectedValue="{Binding Kind}" SelectedValuePath="Tag" Background="#232428" Foreground="#17191C">
  <ComboBoxItem Content="Насос" Tag="{x:Static local:SymbolKind.Pump}" xmlns:local="clr-namespace:SimBridge_Scada.ViewModels.Components"/>
  <ComboBoxItem Content="Задвижка" Tag="{x:Static local:SymbolKind.Valve}" xmlns:local="clr-namespace:SimBridge_Scada.ViewModels.Components"/>
  <ComboBoxItem Content="Резервуар" Tag="{x:Static local:SymbolKind.Tank}" xmlns:local="clr-namespace:SimBridge_Scada.ViewModels.Components"/>
 </ComboBox>
</UserControl>
