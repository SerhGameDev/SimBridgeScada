<UserControl x:Class="SimBridge_Scada.Views.ImageComponentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Путь к изображению" Margin="0,0,0,6"/>
        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Выбрать файл…" Click="Browse" Margin="0,0,0,8"/>
    </StackPanel>
</UserControl>
