<UserControl x:Class="SimBridge_Scada.Views.FixedPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition/></Grid.RowDefinitions>
   <Border Background="#303236" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/></Border>
   <ContentControl Grid.Row="1" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </Grid>
 </Border>
</UserControl>
