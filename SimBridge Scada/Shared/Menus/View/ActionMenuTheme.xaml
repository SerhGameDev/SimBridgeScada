<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="ContextMenu">
  <Setter Property="Foreground" Value="#DFE1E5"/><Setter Property="Background" Value="#2B2D30"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
   <Border Background="#2B2D30" BorderBrush="#55585E" BorderThickness="1" CornerRadius="5" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="MenuItem">
  <Setter Property="Foreground" Value="#DFE1E5"/><Setter Property="FontSize" Value="13"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
   <Grid>
    <Border x:Name="Chrome" Background="Transparent" CornerRadius="3" Padding="10,7" MinWidth="210">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
      <ContentPresenter Content="{TemplateBinding Icon}" VerticalAlignment="Center"/>
      <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#858A93" Margin="24,0,0,0"/>
      <TextBlock x:Name="Arrow" Grid.Column="3" Text="›" Foreground="#9DA0A8" HorizontalAlignment="Right" Visibility="Collapsed"/>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" PopupAnimation="Fade">
     <Border Background="#2B2D30" BorderBrush="#55585E" BorderThickness="1" CornerRadius="5" Padding="4"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer></Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#2E4361"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Separator"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#43454A" Margin="4,5"/></ControlTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
